    "clsx": "^2.1.1",
    "docx": "^9.11.0",
    "dotenv": "^18.0.7",
    "lucide-react": "^1.56.0",
    "mammoth": "^1.13.0",
    "monaco-editor": "^0.57.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pptxgenjs": "^4.0.1",
    "prisma": "^7.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "read-excel-file": "^9.3.12",
