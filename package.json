{
  "name": "omni-ai",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-monaco.mjs && next dev -H 127.0.0.1",
    "build": "prisma generate && node scripts/copy-monaco.mjs && next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
