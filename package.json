    "test:e2e": "node scripts/e2e.mjs",
    "postinstall": "prisma generate && node scripts/copy-monaco.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test:integration": "node scripts/test-integration.mjs",
    "db:clear-test": "node scripts/clear-test-data.mjs"
  },
  "dependencies": {
