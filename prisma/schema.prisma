generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MessageRole {
  system
  user
  assistant
}

enum MessageStatus {
  streaming
  complete
  stopped
  error
}

enum UsageStatus {
  complete
  stopped
  error
}

enum CostSource {
  openrouter
  estimated
  unknown
}

/// Single-row table (id = 1) holding workspace-level OpenRouter settings.
model AppSettings {
  id               Int       @id @default(1)
  encryptedApiKey  String?   @db.Text
  apiKeyLast4      String?
  apiKeyUpdatedAt  DateTime?
  defaultModelId   String?
  favoriteModelIds String[]  @default([])
  monthlyBudgetUsd Float?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Conversation {
  id           String        @id @default(cuid())
  title        String        @default("New chat")
  modelId      String?
  systemPrompt String?       @db.Text
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  messages     Message[]
  usage        UsageRecord[]

  @@index([updatedAt])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String        @db.Text
  modelId        String?
  status         MessageStatus @default(complete)
  error          String?       @db.Text
  createdAt      DateTime      @default(now())
  usage          UsageRecord?

  @@index([conversationId, createdAt])
}

model UsageRecord {
  id               String        @id @default(cuid())
  createdAt        DateTime      @default(now())
  conversationId   String?
  conversation     Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  messageId        String?       @unique
  message          Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
  modelId          String
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  costUsd          Float?
  costSource       CostSource    @default(unknown)
  status           UsageStatus

  @@index([createdAt])
}

enum TaskStatus {
  todo
  in_progress
  done
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum ProjectStatus {
  planning
  active
  on_hold
  completed
  archived
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String        @default("") @db.Text
  status      ProjectStatus @default(planning)
  dueDate     DateTime?     @db.Date
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  milestones  Milestone[]
  tasks       Task[]

  @@index([status, updatedAt])
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  dueDate     DateTime? @db.Date
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  tasks       Task[]

  @@index([projectId, dueDate])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String       @default("") @db.Text
  status      TaskStatus   @default(todo)
  priority    TaskPriority @default(medium)
  dueDate     DateTime?    @db.Date
  completedAt DateTime?
  tags        String[]     @default([])
  /// Orders cards within a board column (and subtasks within a parent). Lower comes first.
  position    Float        @default(0)
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  milestoneId String?
  milestone   Milestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  parentId    String?
  parent      Task?        @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks    Task[]       @relation("Subtasks")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, position])
  @@index([projectId])
  @@index([parentId])
  @@index([dueDate])
}

model NoteFolder {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  notes     Note[]
}

model Note {
  id        String      @id @default(cuid())
  title     String      @default("")
  content   String      @default("") @db.Text
  tags      String[]    @default([])
  pinned    Boolean     @default(false)
  folderId  String?
  folder    NoteFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([updatedAt])
  @@index([folderId])
}

enum AgentRunStatus {
  queued
  running
  awaiting_approval
  completed
  failed
  cancelled
}

enum AgentStepKind {
  action
  final
  invalid
}

enum AgentStepStatus {
  pending_approval
  approved
  running
  rejected
  ok
  error
}

model Agent {
  id            String     @id @default(cuid())
  name          String
  description   String     @default("") @db.Text
  instructions  String     @default("") @db.Text
  modelId       String?
  /// Tool names this agent may use.
  tools         String[]   @default([])
  /// Subset of `tools` that pause for the user's approval before running.
  approvalTools String[]   @default([])
  maxSteps      Int        @default(10)
  maxBudgetUsd  Float      @default(0.25)
  /// Set for agents that ship with the app; those are read-only (duplicate to customize).
  builtInKey    String?    @unique
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  runs          AgentRun[]
}

model AgentRun {
  id          String         @id @default(cuid())
  agentId     String
  agent       Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  parentRunId String?
  parentRun   AgentRun?      @relation("Delegation", fields: [parentRunId], references: [id], onDelete: Cascade)
  childRuns   AgentRun[]     @relation("Delegation")
  depth       Int            @default(0)
  objective   String         @db.Text
  status      AgentRunStatus @default(queued)
  result      String?        @db.Text
  error       String?        @db.Text
  stepCount   Int            @default(0)
  totalTokens Int            @default(0)
  costUsd     Float          @default(0)
  /// Spending cap for this run; a delegated run gets at most what its parent has left.
  budgetUsd   Float
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  steps       AgentStep[]

  @@index([agentId, createdAt])
  @@index([status])
  @@index([parentRunId])
}

model AgentStep {
  id        String          @id @default(cuid())
  runId     String
  run       AgentRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  index     Int
  kind      AgentStepKind
  thought   String?         @db.Text
  tool      String?
  input     Json?
  output    String?         @db.Text
  status    AgentStepStatus @default(ok)
  createdAt DateTime        @default(now())

  @@unique([runId, index])
}

/// The single owner's password. Row id is always 1, so a second setup attempt fails on the primary key.
model AuthConfig {
  id           Int      @id @default(1)
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// A signed-in browser. Only a SHA-256 of the cookie token is stored, never the token itself.
model AuthSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime

  @@index([expiresAt])
}

/// Security-relevant events. `detail` never contains secrets.
model AuditLog {
  id        String   @id @default(cuid())
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
