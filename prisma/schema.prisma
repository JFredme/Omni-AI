generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MessageRole {
  system
  user
  assistant
}

enum MessageStatus {
  streaming
  complete
  stopped
  error
}

enum UsageStatus {
  complete
  stopped
  error
}

enum CostSource {
  openrouter
  estimated
  unknown
}

/// Single-row table (id = 1) holding workspace-level OpenRouter settings.
model AppSettings {
  id               Int       @id @default(1)
  encryptedApiKey  String?   @db.Text
  apiKeyLast4      String?
  apiKeyUpdatedAt  DateTime?
  defaultModelId   String?
  favoriteModelIds String[]  @default([])
  monthlyBudgetUsd Float?
  /// Model used to embed documents and memories. Null means the built-in default.
  embeddingModelId String?
  /// Whether saved memories are offered to the model in chat.
  memoryEnabled    Boolean   @default(true)
  /// Web search provider for Research: "brave", "tavily", or "searxng". Null means not set up.
  searchProvider   String?
  encryptedSearchKey String? @db.Text
  searchKeyLast4   String?
  /// For SearXNG: the address of your instance.
  searchBaseUrl    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Conversation {
  id           String        @id @default(cuid())
  title        String        @default("New chat")
  modelId      String?
  systemPrompt String?       @db.Text
  /// The last message of the branch currently shown. Plain id, not a foreign key, so branches can be added freely.
  leafId       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  messages     Message[]
  usage        UsageRecord[]
  attachments  Attachment[]

  @@index([updatedAt])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String        @db.Text
  modelId        String?
  status         MessageStatus @default(complete)
  error          String?       @db.Text
  /// Sources and memories retrieved for this reply: [{ n, kind, documentId, name, page, heading, snippet, score }]
  citations      Json?
  /// The message this one replies to. Messages form a tree so edits and regenerated replies become branches.
  parentId       String?
  parent         Message?      @relation("MessageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children       Message[]     @relation("MessageTree")
  attachments    Attachment[]
  createdAt      DateTime      @default(now())
  usage          UsageRecord?

  @@index([conversationId, createdAt])
  @@index([parentId])
}

model UsageRecord {
  id               String        @id @default(cuid())
  createdAt        DateTime      @default(now())
  conversationId   String?
  conversation     Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  messageId        String?       @unique
  message          Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
  modelId          String
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  costUsd          Float?
  costSource       CostSource    @default(unknown)
  status           UsageStatus

  @@index([createdAt])
}

enum TaskStatus {
  todo
  in_progress
  done
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum ProjectStatus {
  planning
  active
  on_hold
  completed
  archived
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String        @default("") @db.Text
  status      ProjectStatus @default(planning)
  dueDate     DateTime?     @db.Date
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  milestones  Milestone[]
  tasks       Task[]

  @@index([status, updatedAt])
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  dueDate     DateTime? @db.Date
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  tasks       Task[]

  @@index([projectId, dueDate])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String       @default("") @db.Text
  status      TaskStatus   @default(todo)
  priority    TaskPriority @default(medium)
  dueDate     DateTime?    @db.Date
  completedAt DateTime?
  tags        String[]     @default([])
  /// Orders cards within a board column (and subtasks within a parent). Lower comes first.
  position    Float        @default(0)
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  milestoneId String?
  milestone   Milestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  parentId    String?
  parent      Task?        @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks    Task[]       @relation("Subtasks")
  events      CalendarEvent[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, position])
  @@index([projectId])
  @@index([parentId])
  @@index([dueDate])
}

model NoteFolder {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  notes     Note[]
}

model Note {
  id        String      @id @default(cuid())
  title     String      @default("")
  content   String      @default("") @db.Text
  tags      String[]    @default([])
  pinned    Boolean     @default(false)
  folderId  String?
  folder    NoteFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([updatedAt])
  @@index([folderId])
}

enum AgentRunStatus {
  queued
  running
  awaiting_approval
  completed
  failed
  cancelled
}

enum AgentStepKind {
  action
  final
  invalid
}

enum AgentStepStatus {
  pending_approval
  approved
  running
  rejected
  ok
  error
}

model Agent {
  id            String     @id @default(cuid())
  name          String
  description   String     @default("") @db.Text
  instructions  String     @default("") @db.Text
  modelId       String?
  /// Tool names this agent may use.
  tools         String[]   @default([])
  /// Subset of `tools` that pause for the user's approval before running.
  approvalTools String[]   @default([])
  maxSteps      Int        @default(10)
  maxBudgetUsd  Float      @default(0.25)
  /// Set for agents that ship with the app; those are read-only (duplicate to customize).
  builtInKey    String?    @unique
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  runs          AgentRun[]
}

model AgentRun {
  id          String         @id @default(cuid())
  agentId     String
  agent       Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  parentRunId String?
  parentRun   AgentRun?      @relation("Delegation", fields: [parentRunId], references: [id], onDelete: Cascade)
  childRuns   AgentRun[]     @relation("Delegation")
  depth       Int            @default(0)
  objective   String         @db.Text
  status      AgentRunStatus @default(queued)
  result      String?        @db.Text
  error       String?        @db.Text
  stepCount   Int            @default(0)
  totalTokens Int            @default(0)
  costUsd     Float          @default(0)
  /// Spending cap for this run; a delegated run gets at most what its parent has left.
  budgetUsd   Float
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  steps       AgentStep[]

  @@index([agentId, createdAt])
  @@index([status])
  @@index([parentRunId])
}

model AgentStep {
  id        String          @id @default(cuid())
  runId     String
  run       AgentRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  index     Int
  kind      AgentStepKind
  thought   String?         @db.Text
  tool      String?
  input     Json?
  output    String?         @db.Text
  status    AgentStepStatus @default(ok)
  createdAt DateTime        @default(now())

  @@unique([runId, index])
}

/// The single owner's password. Row id is always 1, so a second setup attempt fails on the primary key.
model AuthConfig {
  id           Int      @id @default(1)
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// A signed-in browser. Only a SHA-256 of the cookie token is stored, never the token itself.
model AuthSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime

  @@index([expiresAt])
}

/// Security-relevant events. `detail` never contains secrets.
model AuditLog {
  id        String   @id @default(cuid())
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum KnowledgeStatus {
  processing
  ready
  failed
}

/// A file, note, or pasted text that has been split into searchable chunks.
model KnowledgeDocument {
  id              String          @id @default(cuid())
  name            String
  kind            String
  sourceType      String          @default("file")
  sourceId        String?
  mimeType        String?
  sizeBytes       Int             @default(0)
  status          KnowledgeStatus @default(processing)
  error           String?         @db.Text
  chunkCount      Int             @default(0)
  embeddedCount   Int             @default(0)
  embeddingModel  String?
  tags            String[]        @default([])
  sourceUpdatedAt DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  chunks          KnowledgeChunk[]

  @@unique([sourceType, sourceId])
  @@index([createdAt])
}

model KnowledgeChunk {
  id             String            @id @default(cuid())
  documentId     String
  document       KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  index          Int
  content        String            @db.Text
  heading        String?
  page           Int?
  /// Unit-length float32 vector, little-endian. Null until embedded.
  embedding      Bytes?
  embeddingModel String?

  @@index([documentId, index])
}

/// Something the user wants the assistant to remember.
model Memory {
  id             String   @id @default(cuid())
  content        String   @db.Text
  source         String   @default("user")
  embedding      Bytes?
  embeddingModel String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([createdAt])
}

/// A file the user attached to a chat message. Images are sent to vision models; documents are read to text.
model Attachment {
  id            String        @id @default(cuid())
  conversationId String?
  conversation  Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId     String?
  message       Message?      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  name          String
  kind          String
  mimeType      String
  sizeBytes     Int
  data          Bytes
  extractedText String?       @db.Text
  createdAt     DateTime      @default(now())

  @@index([messageId])
  @@index([createdAt])
}

/// A calendar entry. Timed events store the exact instant; all-day events store UTC midnight dates (end is exclusive).
model CalendarEvent {
  id          String   @id @default(cuid())
  /// Identifies the event across imports and exports (the iCalendar UID).
  uid         String   @unique @default(cuid())
  title       String
  description String   @default("") @db.Text
  location    String   @default("")
  startsAt    DateTime
  endsAt      DateTime
  allDay      Boolean  @default(false)
  /// IANA zone the event is scheduled in. Repeats keep this zone's wall-clock time through daylight saving.
  timezone    String   @default("UTC")
  /// { freq, interval, byDay?, until?, count? } or null for a one-off event.
  recurrence  Json?
  /// Dates (YYYY-MM-DD) of repeats that were removed or edited on their own.
  exdates     String[] @default([])
  taskId      String?
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startsAt])
  @@index([taskId])
}

enum WorkflowRunStatus {
  running
  succeeded
  failed
  skipped
}

enum WorkflowStepStatus {
  running
  ok
  error
  skipped
}

/// An automation: one trigger and an ordered list of steps. Both are stored as validated JSON.
model Workflow {
  id               String        @id @default(cuid())
  name             String
  description      String        @default("")
  /// New automations start switched off so nothing runs before the user has looked at it.
  enabled          Boolean       @default(false)
  trigger          Json
  steps            Json
  /// For schedule triggers: when it fires next.
  nextRunAt        DateTime?
  lastRunAt        DateTime?
  /// SHA-256 of the webhook secret. The secret itself is shown once and never stored.
  webhookTokenHash String?       @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  runs             WorkflowRun[]

  @@index([enabled, nextRunAt])
}

model WorkflowRun {
  id          String            @id @default(cuid())
  workflowId  String
  workflow    Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status      WorkflowRunStatus @default(running)
  triggerType String
  triggerData Json?
  error       String?           @db.Text
  startedAt   DateTime          @default(now())
  finishedAt  DateTime?
  steps       WorkflowRunStep[]

  @@index([workflowId, startedAt])
}

model WorkflowRunStep {
  id         String             @id @default(cuid())
  runId      String
  run        WorkflowRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  index      Int
  type       String
  status     WorkflowStepStatus @default(running)
  input      Json?
  output     Json?
  error      String?            @db.Text
  startedAt  DateTime           @default(now())
  finishedAt DateTime?

  @@index([runId, index])
}

enum ResearchStatus {
  running
  complete
  failed
  stopped
}

/// A researched answer: the question, the report, and every source it was built from.
model ResearchReport {
  id        String         @id @default(cuid())
  question  String         @db.Text
  depth     String         @default("quick")
  status    ResearchStatus @default(running)
  report    String         @default("") @db.Text
  /// [{ n, title, url, snippet, read: boolean, note?: string, cited: boolean }]
  sources   Json           @default("[]")
  queries   String[]       @default([])
  modelId   String?
  error     String?        @db.Text
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([createdAt])
}

/// A folder of source files in the code workspace.
model CodeProject {
  id        String     @id @default(cuid())
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  files     CodeFile[]

  @@index([updatedAt])
}

model CodeFile {
  id        String      @id @default(cuid())
  projectId String
  project   CodeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Relative path inside the project, like "src/main.py".
  path      String
  content   String      @default("") @db.Text
  updatedAt DateTime    @updatedAt

  @@unique([projectId, path])
}

/// A connection to an outside service. Credentials are encrypted with ENCRYPTION_KEY and never sent back to the browser.
model Integration {
  provider             String    @id
  /// Who or what we're connected as, read from the service itself (a GitHub login, a Google email, a workspace name).
  account              String?
  encryptedCredentials String    @db.Text
  scopes               String[]  @default([])
  /// For OAuth: when the access token expires.
  expiresAt            DateTime?
  lastUsedAt           DateTime?
  lastError            String?   @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

/// A sign-in-with-Google attempt in progress. The row is deleted when it's used, and ignored after ten minutes.
model OAuthState {
  state     String   @id
  provider  String
  verifier  String
  scopeSet  String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
